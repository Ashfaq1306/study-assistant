<?xml version="1.0" encoding="utf-8"?>
<!-- Window changes say which app opened; the window list (retrieveInteractiveWindows)
     catches locked apps that are already open, e.g. in split screen. Only the package
     that owns each window is read, never what is inside it. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRetrieveInteractiveWindows"
    android:canRetrieveWindowContent="true"
    android:description="@string/app_lock_service_description"
    android:notificationTimeout="100" />
