<?xml version="1.0" encoding="utf-8"?>
<!-- Frosted night glass: deep indigo with a soft light edge. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="28dp" />
    <gradient
        android:angle="315"
        android:centerColor="#E62B2160"
        android:endColor="#E6402A8C"
        android:startColor="#E6211B47"
        android:type="linear" />
    <stroke
        android:width="1dp"
        android:color="#40FFFFFF" />
</shape>
