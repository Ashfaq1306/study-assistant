<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Test (debug and profile) builds only: install a newer test build downloaded from GitHub
         Releases (silently when Android allows it, otherwise Android asks). Never in Play builds:
         Google Play restricts this permission. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
    <!-- Keeps the update check scheduled after the phone restarts. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>

    <application>
        <!-- Automatic updates for test builds (see update/AutoUpdater.kt). -->
        <service
            android:name="com.ashfaq.study_assistant.update.UpdateJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <receiver
            android:name="com.ashfaq.study_assistant.update.UpdateStatusReceiver"
            android:exported="false" />

    </application>
</manifest>
