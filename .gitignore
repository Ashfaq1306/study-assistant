# ── Secrets: never commit ────────────────────────────────────────────────
.env
.env.*
!.env.example
*.keystore
*.jks
key.properties
google-services.json
GoogleService-Info.plist
*.pem

# ── Editors and OS ──────────────────────────────────────────────────────
.idea/
.vscode/
*.iml
*.swp
.DS_Store
Thumbs.db

# ── Claude Code: share agents and settings, keep personal overrides local
.claude/settings.local.json

# ── Node (backend, admin) ───────────────────────────────────────────────
node_modules/
dist/
coverage/
*.log
npm-debug.log*
*.tsbuildinfo

# ── Prisma / SQLite local databases ─────────────────────────────────────
*.db
*.db-journal
*.sqlite

# ── Flutter / Dart (app/ also has its own .gitignore) ───────────────────
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
build/
doc/api/

# Local agent worktrees
.claude/worktrees/
