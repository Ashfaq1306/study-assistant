// Study Assistant data model.
// Development uses SQLite. For production switch `provider` to "postgresql"
// and point DATABASE_URL at your Postgres instance.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  PARENT
  ADMIN
}

enum OtpChannel {
  EMAIL
  SMS
}

enum SessionStatus {
  /// Timer running; the chosen apps are locked.
  STUDYING
  /// Study time is over; apps stay locked until an exam is passed.
  EXAM_PENDING
  /// Exam passed; apps unlocked.
  PASSED
  /// Ended by an admin (support only). Students cannot cancel a lock.
  CANCELLED
}

enum ExamStatus {
  ACTIVE
  SUBMITTED
  /// Not submitted in time; counts as a failed attempt.
  EXPIRED
}

enum ParentLockStatus {
  ACTIVE
  /// The student passed the exam: apps are unlocked.
  PASSED
  /// The parent lifted the lock.
  CANCELLED
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum OtpPurpose {
  VERIFY_ACCOUNT
  RESET_PASSWORD
}

model User {
  id              String     @id @default(cuid())
  role            Role
  name            String
  email           String?    @unique
  phone           String?    @unique // E.164, e.g. +8801712345678
  passwordHash    String
  dateOfBirth     DateTime
  otpChannel      OtpChannel
  /// Set when the account is first opened with a code.
  verifiedAt      DateTime?
  /// A contact may only be used to sign in or reset the password once a code has been received on it.
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  disabledAt      DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  otpCodes      OtpCode[]
  sessions      Session[]
  pairingCodes  PairingCode[]  @relation("PairingStudent")
  childLinks    FamilyLink[]   @relation("ParentLinks")
  parentLinks   FamilyLink[]   @relation("StudentLinks")
  studySessions StudySession[]
  devices       Device[]
  exams         Exam[]
  aiUsage       AiUsage[]
  locksSet      ParentLock[]   @relation("LocksSetByParent")
  locksOn       ParentLock[]   @relation("LocksOnStudent")
  questionSets  QuestionSet[]
  usageDays     UsageDay[]
  notifications Notification[]
}

model OtpCode {
  id         String     @id @default(cuid())
  userId     String
  purpose    OtpPurpose
  channel    OtpChannel
  codeHash   String
  attempts   Int        @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, createdAt])
}

/// One row per code sent, keyed by an HMAC of the destination (not the user),
/// so resend limits survive deleting and re-creating an unverified signup.
model OtpSend {
  id              String   @id @default(cuid())
  destinationHash String
  createdAt       DateTime @default(now())

  @@index([destinationHash, createdAt])
}

/// A refresh-token session. Tokens rotate on every refresh; reuse of a
/// rotated token revokes the whole family (stolen-token detection).
model Session {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  familyId   String
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedAt DateTime?
  userAgent  String?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

/// Short-lived code a student shows as a QR so a parent can link to them.
model PairingCode {
  id         String    @id @default(cuid())
  studentId  String
  codeHash   String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  student User @relation("PairingStudent", fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

model FamilyLink {
  id        String   @id @default(cuid())
  parentId  String
  studentId String
  createdAt DateTime @default(now())

  parent  User @relation("ParentLinks", fields: [parentId], references: [id], onDelete: Cascade)
  student User @relation("StudentLinks", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])
  @@index([studentId])
}

/// One study block: what the student will study, for how long, which apps are
/// locked meanwhile, and the exam they must pass to unlock them.
model StudySession {
  id                 String        @id @default(cuid())
  studentId          String
  subject            String
  topics             String
  plannedMinutes     Int
  status             SessionStatus @default(STUDYING)
  /// JSON array of Android package names locked during the session.
  lockedApps         String        @default("[]")
  /// Also block Settings, Play Store and the package installer while locked.
  strict             Boolean       @default(true)
  questionCount      Int
  totalMarks         Int
  passMarks          Int
  /// JSON array of QuestionType values.
  questionTypes      String
  difficulty         Difficulty    @default(MEDIUM)
  /// Share of the timer after which the student may finish early, fixed at start.
  earlyFinishPercent Int           @default(50)
  startedAt          DateTime      @default(now())
  /// When studying stopped (timer finished or finished early).
  studyEndedAt       DateTime?
  completedAt        DateTime?

  student User   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  exams   Exam[]

  @@index([studentId, status])
  @@index([studentId, startedAt])
}

/// Admin-editable settings, one JSON value per key (see config.service.ts).
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// A student's phone. It authenticates with its own revocable token, so the
/// native app blocker can sync even when the app is closed or signed out.
model Device {
  id            String    @id @default(cuid())
  studentId     String
  tokenHash     String    @unique
  name          String
  platform      String
  appVersion    String?
  /// The accessibility service that enforces locks is switched on.
  protectionOn  Boolean   @default(false)
  /// Usage access (screen time) is granted.
  usageAccess   Boolean   @default(false)
  /// An accessibility shortcut could switch the lock off without Settings.
  shortcutOn    Boolean   @default(false)
  /// JSON array of { package, label } for apps that can be launched.
  installedApps String    @default("[]")
  lastSeenAt    DateTime  @default(now())
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())

  student   User       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  usageDays UsageDay[]

  @@index([studentId])
}

/// An unlock exam. Questions and answers stay on the server; the app only
/// sees the answers after submitting.
model Exam {
  id           String     @id @default(cuid())
  studentId    String
  sessionId    String?
  /// Set when the exam unlocks a parent's lock instead of a study session.
  parentLockId String?
  subject      String
  topics       String
  difficulty   Difficulty
  totalMarks   Int
  passMarks    Int
  /// JSON array of questions with their answers and marks.
  questions    String
  /// AI, PRACTICE (built-in bank when AI is off) or PARENT.
  source       String
  status       ExamStatus @default(ACTIVE)
  /// studentId:target while ACTIVE, cleared when submitted or expired: at most one running exam per target.
  activeKey    String?    @unique
  /// JSON map of questionId -> answer, once submitted.
  answers      String?
  /// JSON array of per-question results, once submitted.
  results      String?
  score        Float?
  passed       Boolean?
  createdAt    DateTime   @default(now())
  expiresAt    DateTime
  submittedAt  DateTime?

  student    User          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  session    StudySession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  parentLock ParentLock?   @relation(fields: [parentLockId], references: [id], onDelete: Cascade)

  @@index([studentId, createdAt])
  @@index([sessionId])
  @@index([parentLockId])
}

/// One row per AI call, for daily limits and admin statistics.
model AiUsage {
  id        String   @id @default(cuid())
  userId    String
  kind      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind, createdAt])
}

/// A lock a parent puts on a child's phone. Only passing its exam (or the parent) lifts it.
model ParentLock {
  id            String           @id @default(cuid())
  parentId      String
  studentId     String
  title         String
  subject       String
  topics        String
  /// JSON array of package names; ["*"] locks the whole phone.
  lockedApps    String           @default("[]")
  strict        Boolean          @default(false)
  /// Use the parent's own questions instead of AI-written ones.
  questionSetId String?
  questionCount Int
  totalMarks    Int
  passMarks     Int
  /// JSON array of QuestionType values.
  questionTypes String
  difficulty    Difficulty       @default(MEDIUM)
  status        ParentLockStatus @default(ACTIVE)
  createdAt     DateTime         @default(now())
  endedAt       DateTime?

  parent      User         @relation("LocksSetByParent", fields: [parentId], references: [id], onDelete: Cascade)
  student     User         @relation("LocksOnStudent", fields: [studentId], references: [id], onDelete: Cascade)
  questionSet QuestionSet? @relation(fields: [questionSetId], references: [id], onDelete: SetNull)
  exams       Exam[]

  @@index([studentId, status])
  @@index([parentId, createdAt])
}

/// Questions a parent wrote, used for the exams on their locks.
model QuestionSet {
  id        String   @id @default(cuid())
  parentId  String
  title     String
  subject   String
  /// JSON array of { type, prompt, options, answer, explanation }.
  questions String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent User         @relation(fields: [parentId], references: [id], onDelete: Cascade)
  locks  ParentLock[]

  @@index([parentId])
}

/// Screen time for one phone on one day (the phone's local date).
model UsageDay {
  id           String   @id @default(cuid())
  studentId    String
  deviceId     String
  /// YYYY-MM-DD on the phone.
  day          String
  totalMinutes Int
  /// JSON array of { package, minutes }, most used first.
  apps         String
  updatedAt    DateTime @updatedAt

  student User   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  device  Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, day])
  @@index([studentId, day])
}

/// In-app alerts (exam results, protection switched off, …).
model Notification {
  id        String    @id @default(cuid())
  userId    String
  kind      String
  title     String
  body      String
  /// JSON with ids the app can open (studentId, examId, …).
  data      String    @default("{}")
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
