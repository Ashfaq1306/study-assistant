# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=8080
HOST=0.0.0.0
# Proxies in front of the API: false (none), a hop count like 1, or proxy IPs/CIDRs.
TRUST_PROXY=false
LOG_LEVEL=info

# SQLite file for development. Production: a postgresql:// URL.
DATABASE_URL="file:./dev.db"

# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
OTP_SECRET=change-me-to-another-long-random-string-32-chars

# Comma-separated origins allowed to call the API from a browser (admin panel).
CORS_ORIGINS=http://localhost:5173

# Local testing only: return OTPs in API responses (the app shows them).
# Never enable on a server other people can reach; refused in production.
EXPOSE_DEV_CODES=true

# AI exams and study helper (Claude). Leave empty to use built-in practice questions.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_EXAM_EFFORT=medium
AI_TUTOR_EFFORT=low

# console = print OTPs in the server log (development only)
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Study Assistant <no-reply@example.com>"

# console | twilio
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
